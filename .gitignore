# Runtime chain state - generated per node instance, not source.
# Equivalent to a database file: never belongs in version control.
state.json
blockchain.json
config.json
identity.json

# Compiled binaries
creditchaind
creditchaind.exe
/creditchaind_*
creditchaind-linux-amd64

# Local tool config, not project source
.claude/

# OS artifacts
.DS_Store
Thumbs.db

# Runtime logs - generated by a running node (e.g. fork_events.log from
# api/fork_monitor.go), not source, same reasoning as state.json above.
*.log
