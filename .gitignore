# Runtime chain state - generated per node instance, not source.
# Equivalent to a database file: never belongs in version control.
state.json
blockchain.json
config.json
identity.json

# Compiled binaries
creditchaind
creditchaind.exe
/creditchaind_*
creditchaind-linux-amd64

# Local tool config, not project source
.claude/

# OS artifacts
.DS_Store
Thumbs.db

# Runtime logs - generated by a running node (e.g. fork_events.log from
# api/fork_monitor.go), not source, same reasoning as state.json above.
*.log

# Encrypted KYC submissions/certificates (api/hub_kyc.go, api/apply.go) -
# written under dataDir() (api/datadir.go), which defaults to "." with
# no DATA_DIR set, so a plain `go run .`/`go test ./api/...` from the
# api/ package writes them straight into api/. Same "runtime data, not
# source" reasoning as state.json/blockchain.json above - these were
# repeatedly showing up as untracked noise after every local test run.
api/hub_kyc_*.json.enc
api/certificates/
