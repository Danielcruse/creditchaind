# Copy to /etc/creditchain-healthcheck.env (root:root, chmod 600 - not
# strictly secret, but matches the same handling convention as the backup
# env file for consistency).

# This node's own API base.
HEALTHCHECK_LOCAL_URL=http://localhost:8080

# The OTHER node's API base - used for the fork-detection check
# (same height, different hash = alert). Leave unset to skip this check
# on a single-node setup.
HEALTHCHECK_PEER_URL=https://creditchain.site:8080

# Where to remember the last-seen block height between runs.
HEALTHCHECK_STATE_FILE=/var/lib/creditchain-healthcheck/state

# Optional: a free heartbeat/"dead man's switch" monitor URL (e.g. from
# healthchecks.io or UptimeRobot's heartbeat monitor type). Pinged only on
# a clean run - if this script stops running at all (box down, crash-
# looped), the external monitor's own "no heartbeat" alert is what
# actually notifies a human. Leave unset to skip.
# HEALTHCHECK_PING_URL=https://hc-ping.com/your-check-id-here

# Optional overrides (defaults shown):
# HEALTHCHECK_DISK_PATH=/opt/creditchain
# HEALTHCHECK_DISK_THRESHOLD=85
# HEALTHCHECK_STALL_SECONDS=300
