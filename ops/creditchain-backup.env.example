# Copy to /etc/creditchain-backup.env on each node (chmod 600, root-owned -
# it holds an AWS access key) and fill in real values. Never commit the
# filled-in version to git - only this .example template belongs in the repo.

# node1: /opt/creditchain/data   node2: /home/ubuntu/creditchain/data
BACKUP_DATA_DIR=/opt/creditchain/data

BACKUP_S3_BUCKET=changeme-bucket-name
# Use a different prefix per node so their snapshots don't collide.
BACKUP_S3_PREFIX=node1

# The operator's GPG key ID/fingerprint (public key only - import it
# first with: gpg --import operator_pubkey.asc)
BACKUP_GPG_RECIPIENT=changeme-key-id

# Scoped to PutObject/GetObject/ListBucket on BACKUP_S3_BUCKET only -
# never a broader/admin AWS credential.
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_DEFAULT_REGION=changeme
